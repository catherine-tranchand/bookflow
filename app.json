{
  "expo": {
    "name": "BookFlow",
    "slug": "bookflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/logo1.png",
    "scheme": "bookflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ekaterinatranchand.bookflow"
    },
    "android": {
      "package": "com.ekaterinatranchand.bookflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/logo1.png",
        "backgroundColor": "#161622"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/logo1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/logo1.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#161622"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Poppins-Black.ttf",
            "./assets/fonts/Poppins-Bold.ttf",
            "./assets/fonts/Poppins-ExtraBold.ttf",
            "./assets/fonts/Poppins-ExtraLight.ttf",
            "./assets/fonts/Poppins-Light.ttf",
            "./assets/fonts/Poppins-Medium.ttf",
            "./assets/fonts/Poppins-Regular.ttf",
            "./assets/fonts/Poppins-SemiBold.ttf",
            "./assets/fonts/Poppins-Thin.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photoPermission": "BookFlow uses your photos to add pictures of your books and your profile.",
          "cameraPermission": "BookFlow uses your camera to photograph books you want to share."
        }
      ],
      "expo-web-browser",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}